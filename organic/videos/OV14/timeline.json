{
 "scenes": [
  {
   "id": "s1",
   "text": "Night Routine, aber mit einem Schritt, den keiner erwartet.",
   "start": 0,
   "dur": 3.7857142857142856,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Make-up runter. Toner. Serum. Creme.",
   "start": 3.7857142857142856,
   "dur": 3.302255639097744,
   "speakStart": 3.7857142857142856
  },
  {
   "id": "s3",
   "text": "Lip Oil? Früher ja. Morgens war davon nichts mehr übrig.",
   "start": 7.08796992481203,
   "dur": 3.8067669172932357,
   "speakStart": 7.08796992481203
  },
  {
   "id": "s4",
   "text": "Jetzt: Tape. Lippen zu, sanft drüberlegen, kurz andrücken.",
   "start": 10.894736842105265,
   "dur": 4.036090225563907,
   "speakStart": 10.894736842105265
  },
  {
   "id": "s5",
   "text": "In der Mitte sitzt eine kleine Lippenmaske mit Kollagen, Hyaluronsäure und Vitamin E.",
   "start": 14.930827067669172,
   "dur": 4.494736842105263,
   "speakStart": 14.930827067669172
  },
  {
   "id": "s6",
   "text": "Medizinische Baumwolle, hypoallergener Kleber. Fühlt sich nicht an wie ein Pflaster.",
   "start": 19.425563909774436,
   "dur": 4.861654135338348,
   "speakStart": 19.425563909774436
  },
  {
   "id": "s7",
   "text": "Licht aus. Morgens langsam abziehen, und meine Lippen fühlen sich so weich an.",
   "start": 24.287218045112784,
   "dur": 4.586466165413533,
   "speakStart": 24.287218045112784
  },
  {
   "id": "s8",
   "text": "Speicher dir das für heute Abend.",
   "start": 28.873684210526317,
   "dur": 2.1763157894736835,
   "speakStart": 28.873684210526317
  }
 ],
