{
 "scenes": [
  {
   "id": "s1",
   "text": "Night Routine, aber mit einem Schritt, den keiner erwartet.",
   "start": 0,
   "dur": 4.157166171428571,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Make-up runter. Toner. Serum. Creme.",
   "start": 4.157166171428571,
   "dur": 3.65415742556391,
   "speakStart": 4.157166171428571
  },
  {
   "id": "s3",
   "text": "Lip Oil? Früher ja. Morgens war davon nichts mehr übrig.",
   "start": 7.811323596992481,
   "dur": 4.212431476691729,
   "speakStart": 7.811323596992481
  },
  {
   "id": "s4",
   "text": "Jetzt: Tape. Lippen zu, sanft drüberlegen, kurz andrücken.",
   "start": 12.02375507368421,
   "dur": 4.466192409022554,
   "speakStart": 12.02375507368421
  },
  {
   "id": "s5",
   "text": "In der Mitte sitzt eine kleine Lippenmaske mit Kollagen, Hyaluronsäure und Vitamin E.",
   "start": 16.489947482706764,
   "dur": 4.973714273684212,
   "speakStart": 16.489947482706764
  },
  {
   "id": "s6",
   "text": "Medizinische Baumwolle, hypoallergener Kleber. Fühlt sich nicht an wie ein Pflaster.",
   "start": 21.463661756390977,
   "dur": 5.379731765413535,
   "speakStart": 21.463661756390977
  },
  {
   "id": "s7",
   "text": "Licht aus. Morgens langsam abziehen, und meine Lippen fühlen sich so weich an.",
   "start": 26.84339352180451,
   "dur": 5.075218646616541,
   "speakStart": 26.84339352180451
  },
  {
   "id": "s8",
   "text": "Speicher dir das für heute Abend.",
   "start": 31.918612168421053,
   "dur": 2.381591831578941,
   "speakStart": 31.918612168421053
  }
 ],
