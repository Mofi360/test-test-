{
 "scenes": [
  {
   "id": "s1",
   "text": "Das hier ist jeden Abend mein letzter Schritt.",
   "start": 0,
   "dur": 3.45,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Mit 54 hab ich aufgehört, mir abends drei verschiedene Sachen auf die Lippen zu schmieren.",
   "start": 3.45,
   "dur": 5.899090909090909,
   "speakStart": 3.45
  },
  {
   "id": "s3",
   "text": "Jetzt ist es ein Tape. Lippen zu, drüberlegen, leicht andrücken.",
   "start": 9.34909090909091,
   "dur": 5.154545454545456,
   "speakStart": 9.34909090909091
  },
  {
   "id": "s4",
   "text": "In der Mitte sitzt eine Pflege mit Kollagen, Hyaluronsäure und Vitamin E.",
   "start": 14.503636363636366,
   "dur": 4.925454545454544,
   "speakStart": 14.503636363636366
  },
  {
   "id": "s5",
   "text": "Und die bleibt die ganze Nacht da, wo sie hin soll.",
   "start": 19.42909090909091,
   "dur": 3.665454545454544,
   "speakStart": 19.42909090909091
  },
  {
   "id": "s6",
   "text": "Morgens zieh ich es langsam ab. Meine Lippen fühlen sich dann richtig weich an.",
   "start": 23.094545454545454,
   "dur": 5.555454545454548,
   "speakStart": 23.094545454545454
  },
  {
   "id": "s7",
   "text": "Das ist Diva Tape. Mehr ist es nicht.",
   "start": 28.650000000000002,
   "dur": 3.399999999999995,
   "speakStart": 28.650000000000002
  }
 ],
