{
 "scenes": [
  {
   "id": "s1",
   "text": "Das hier ist jeden Abend mein letzter Schritt.",
   "start": 0,
   "dur": 3.0846530999999997,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Mit 54 hab ich aufgehört, mir abends drei verschiedene Sachen auf die Lippen zu schmieren.",
   "start": 3.0846530999999997,
   "dur": 5.214895805454547,
   "speakStart": 3.0846530999999997
  },
  {
   "id": "s3",
   "text": "Jetzt ist es ein Tape. Lippen zu, drüberlegen, leicht andrücken.",
   "start": 8.299548905454547,
   "dur": 4.556705072727272,
   "speakStart": 8.299548905454547
  },
  {
   "id": "s4",
   "text": "In der Mitte sitzt eine Pflege mit Kollagen, Hyaluronsäure und Vitamin E.",
   "start": 12.856253978181819,
   "dur": 4.354184847272727,
   "speakStart": 12.856253978181819
  },
  {
   "id": "s5",
   "text": "Und die bleibt die ganze Nacht da, wo sie hin soll.",
   "start": 17.210438825454546,
   "dur": 3.240323607272728,
   "speakStart": 17.210438825454546
  },
  {
   "id": "s6",
   "text": "Morgens zieh ich es langsam ab. Meine Lippen fühlen sich dann richtig weich an.",
   "start": 20.450762432727274,
   "dur": 4.911115467272726,
   "speakStart": 20.450762432727274
  },
  {
   "id": "s7",
   "text": "Das ist Diva Tape. Mehr ist es nicht.",
   "start": 25.3618779,
   "dur": 3.0346531,
   "speakStart": 25.3618779
  }
 ],
