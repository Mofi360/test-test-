{
 "scenes": [
  {
   "id": "s1",
   "text": "Meine beste Freundin kam Samstag aus dem Studio. Frisch gemachte Lippen.",
   "start": 0,
   "dur": 4.628178302752294,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Alle in der Gruppe: Wow. Und ich dachte nur: Ich trau mich das nie.",
   "start": 4.628178302752294,
   "dur": 4.472450912844038,
   "speakStart": 4.628178302752294
  },
  {
   "id": "s3",
   "text": "Ich hab Angst vor dem Schmerz. Und davor, dass es unecht aussieht.",
   "start": 9.100629215596332,
   "dur": 4.23199656269113,
   "speakStart": 9.100629215596332
  },
  {
   "id": "s4",
   "text": "Damit bin ich nicht allein.",
   "start": 13.332625778287461,
   "dur": 1.7312713211009179,
   "speakStart": 13.332625778287461
  },
  {
   "id": "s5",
   "text": "Ich mache was ganz anderes: Pflege. Abends kommt ein Tape über die geschlossenen Lippen.",
   "start": 15.06389709938838,
   "dur": 5.289995703363916,
   "speakStart": 15.06389709938838
  },
  {
   "id": "s6",
   "text": "In der Mitte sind Kollagen, Hyaluronsäure und Vitamin E. Das spendet den Lippen über Nacht Feuchtigkeit.",
   "start": 20.353892802752295,
   "dur": 6.059449623853212,
   "speakStart": 20.353892802752295
  },
  {
   "id": "s7",
   "text": "Morgens fühlen sie sich weich an. Und sie sehen nach mir aus. Genau so will ich das.",
   "start": 26.413342426605507,
   "dur": 5.588086573394495,
   "speakStart": 26.413342426605507
  }
 ],
