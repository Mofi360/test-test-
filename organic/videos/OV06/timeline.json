{
 "scenes": [
  {
   "id": "s1",
   "text": "Ich bin 56 und hab das vorher noch nie gemacht. Also zeig ich dir, wie es richtig geht.",
   "start": 0,
   "dur": 6.26273112191358,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Erstens: Die Haut um den Mund sauber und trocken machen.",
   "start": 6.26273112191358,
   "dur": 3.774572912037039,
   "speakStart": 6.26273112191358
  },
  {
   "id": "s3",
   "text": "Zweitens: Lippen schließen und das Tape sanft drüberlegen.",
   "start": 10.037304033950619,
   "dur": 3.8839808225308623,
   "speakStart": 10.037304033950619
  },
  {
   "id": "s4",
   "text": "Drittens: Einmal leicht andrücken. Die Pflege-Mitte liegt jetzt genau auf den Lippen.",
   "start": 13.921284856481481,
   "dur": 5.853323211419756,
   "speakStart": 13.921284856481481
  },
  {
   "id": "s5",
   "text": "Siehst du das kleine Loch in der Mitte? Das ist ein Sicherheitsloch, da kann Luft durch.",
   "start": 19.774608067901237,
   "dur": 6.017435077160492,
   "speakStart": 19.774608067901237
  },
  {
   "id": "s6",
   "text": "Viertens, und das ist wichtig: Morgens langsam abziehen. Nicht ruckartig, ganz in Ruhe.",
   "start": 25.79204314506173,
   "dur": 6.400362763888889,
   "speakStart": 25.79204314506173
  },
  {
   "id": "s7",
   "text": "Speicher dir das, dann hast du es heute Abend parat.",
   "start": 32.19240590895062,
   "dur": 3.8057570910493794,
   "speakStart": 32.19240590895062
  }
 ],
