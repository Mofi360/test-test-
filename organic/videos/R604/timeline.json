{
 "scenes": [
  {
   "id": "s1",
   "text": "Warum hält Lippenstift bei ihr, und bei dir nicht?",
   "start": 0,
   "dur": 3.3584745762711865,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Teurer Lippenstift? Besserer Pinsel? Glück?",
   "start": 3.3584745762711865,
   "dur": 3.398305084745762,
   "speakStart": 3.3584745762711865
  },
  {
   "id": "s3",
   "text": "Oft liegt es nicht am Lippenstift. Es liegt am Untergrund.",
   "start": 6.756779661016949,
   "dur": 3.689588377723971,
   "speakStart": 6.756779661016949
  },
  {
   "id": "s4",
   "text": "Lippen haben keine Schweißdrüsen und kaum Talgdrüsen. Sie können sich also kaum selbst pflegen. Pflege muss von außen kommen.",
   "start": 10.44636803874092,
   "dur": 7.379176755447945,
   "speakStart": 10.44636803874092
  },
  {
   "id": "s5",
   "text": "Deshalb der Tipp: erst Schüppchen sanft entfernen, dann pflegen. Dann erst Farbe.",
   "start": 17.825544794188865,
   "dur": 5.19455205811138,
   "speakStart": 17.825544794188865
  },
  {
   "id": "s6",
   "text": "Abends dann Diva Tape: Kollagen-Tape für die Lippen, über Nacht. Die Pflege bleibt, wo sie hin soll, nicht im Kissen.",
   "start": 23.020096852300245,
   "dur": 7.330629539951573,
   "speakStart": 23.020096852300245
  },
  {
   "id": "s7",
   "text": "Sie sagt trotzdem, es liegt am teuren Lippenstift. Lass sie.",
   "start": 30.35072639225182,
   "dur": 3.980871670702175,
   "speakStart": 30.35072639225182
  },
  {
   "id": "s8",
   "text": "Schick das deiner Freundin, die ständig nachzieht. Und du: Pflege, Peeling oder einfach hoffen?",
   "start": 34.331598062953994,
   "dur": 6.318401937046005,
   "speakStart": 34.331598062953994
  }
 ],
