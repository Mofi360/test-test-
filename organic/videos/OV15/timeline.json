{
 "scenes": [
  {
   "id": "s1",
   "text": "Die Frage krieg ich ständig: Wofür ist das Loch in der Mitte?",
   "start": 0,
   "dur": 4.101363266331658,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Also, kurz erklärt. Das Tape kommt abends über die geschlossenen Lippen.",
   "start": 4.101363266331658,
   "dur": 4.828758743718593,
   "speakStart": 4.101363266331658
  },
  {
   "id": "s3",
   "text": "In der Mitte sitzt die Pflege mit Kollagen, Hyaluronsäure, Vitamin E und Glycerin.",
   "start": 8.930122010050251,
   "dur": 5.085607613065328,
   "speakStart": 8.930122010050251
  },
  {
   "id": "s4",
   "text": "Und genau da drin ist ein kleines Sicherheitsloch. Da kann Luft durch.",
   "start": 14.015729623115579,
   "dur": 4.520540100502512,
   "speakStart": 14.015729623115579
  },
  {
   "id": "s5",
   "text": "Das ist also mit Absicht so.",
   "start": 18.53626972361809,
   "dur": 1.9006816331658314,
   "speakStart": 18.53626972361809
  },
  {
   "id": "s6",
   "text": "Der Rest ist medizinische Baumwolle mit einem hypoallergenen, atmungsaktiven Kleber.",
   "start": 20.436951356783922,
   "dur": 4.982868065326631,
   "speakStart": 20.436951356783922
  },
  {
   "id": "s7",
   "text": "Morgens langsam abziehen, fertig. Noch Fragen? Schreib sie in die Kommentare.",
   "start": 25.419819422110553,
   "dur": 5.797935577889447,
   "speakStart": 25.419819422110553
  }
 ],
