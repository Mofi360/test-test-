{
 "scenes": [
  {
   "id": "s1",
   "text": "Die Frage krieg ich ständig: Wofür ist das Loch in der Mitte?",
   "start": 0,
   "dur": 4.266499162479062,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Also, kurz erklärt. Das Tape kommt abends über die geschlossenen Lippen.",
   "start": 4.266499162479062,
   "dur": 5.0385259631490795,
   "speakStart": 4.266499162479062
  },
  {
   "id": "s3",
   "text": "In der Mitte sitzt die Pflege mit Kollagen, Hyaluronsäure, Vitamin E und Glycerin.",
   "start": 9.305025125628141,
   "dur": 5.306532663316583,
   "speakStart": 9.305025125628141
  },
  {
   "id": "s4",
   "text": "Und genau da drin ist ein kleines Sicherheitsloch. Da kann Luft durch.",
   "start": 14.611557788944724,
   "dur": 4.716917922948072,
   "speakStart": 14.611557788944724
  },
  {
   "id": "s5",
   "text": "Das ist also mit Absicht so.",
   "start": 19.328475711892796,
   "dur": 1.9832495812395337,
   "speakStart": 19.328475711892796
  },
  {
   "id": "s6",
   "text": "Der Rest ist medizinische Baumwolle mit einem hypoallergenen, atmungsaktiven Kleber.",
   "start": 21.31172529313233,
   "dur": 5.19932998324958,
   "speakStart": 21.31172529313233
  },
  {
   "id": "s7",
   "text": "Morgens langsam abziehen, fertig. Noch Fragen? Schreib sie in die Kommentare.",
   "start": 26.51105527638191,
   "dur": 6.038944723618087,
   "speakStart": 26.51105527638191
  }
 ],
