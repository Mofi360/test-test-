{
 "scenes": [
  {
   "id": "s1",
   "text": "Dieses Symbol auf deinem Lippenstift ignorierst du seit Jahren.",
   "start": 0,
   "dur": 4.225233644859813,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Dreh ihn mal um. Da ist ein offener Tiegel mit einer Zahl.",
   "start": 4.225233644859813,
   "dur": 4.14330218068536,
   "speakStart": 4.225233644859813
  },
  {
   "id": "s3",
   "text": "Recycling? Vegan? Die Größe? Es ist kein Recycling-Zeichen.",
   "start": 8.368535825545173,
   "dur": 5.179127725856695,
   "speakStart": 8.368535825545173
  },
  {
   "id": "s4",
   "text": "Neben der Zahl steht ein M. M wie Monate. So lange ist er nach dem ersten Öffnen verwendbar. So gibt es der Hersteller an.",
   "start": 13.547663551401868,
   "dur": 8.613707165109037,
   "speakStart": 13.547663551401868
  },
  {
   "id": "s5",
   "text": "Das Symbol steht auf Produkten, die ungeöffnet über 30 Monate halten. Deshalb steht dort kein Datum.",
   "start": 22.161370716510906,
   "dur": 6.651090342679126,
   "speakStart": 22.161370716510906
  },
  {
   "id": "s6",
   "text": "Heißt: Die Uhr läuft ab dem Öffnen. Nicht ab dem Kauf.",
   "start": 28.81246105919003,
   "dur": 4.143302180685357,
   "speakStart": 28.81246105919003
  },
  {
   "id": "s7",
   "text": "Schau nach, welche Zahl bei dir steht. Schreib das Datum vom ersten Öffnen drauf.",
   "start": 32.95576323987539,
   "dur": 5.615264797507784,
   "speakStart": 32.95576323987539
  },
  {
   "id": "s8",
   "text": "Riecht er ranzig oder wird er krümelig? Dann ist er nicht mehr gut.",
   "start": 38.57102803738317,
   "dur": 4.633956386292837,
   "speakStart": 38.57102803738317
  },
  {
   "id": "s9",
   "text": "Schick das deiner Freundin, die noch Lippenstifte von 2019 hortet. Wie alt ist dein ältester? Unter einem Jahr, über drei oder lieber geheim?",
   "start": 43.20498442367601,
   "dur": 9.845015576323988,
   "speakStart": 43.20498442367601
  }
 ],
