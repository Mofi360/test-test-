{
 "scenes": [
  {
   "id": "s1",
   "text": "Meine Lippenmaske? Klebte jeden Morgen im Kissen. Nicht auf meinen Lippen.",
   "start": 0,
   "dur": 5.193552680786687,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Abends eine dicke Schicht drauf. Morgens: Lippen trocken, Kissenbezug glänzt.",
   "start": 5.193552680786687,
   "dur": 4.990454714069593,
   "speakStart": 5.193552680786687
  },
  {
   "id": "s3",
   "text": "Mit Plumpern aus der Drogerie war es auch nicht besser.",
   "start": 10.18400739485628,
   "dur": 3.1008650650529503,
   "speakStart": 10.18400739485628
  },
  {
   "id": "s4",
   "text": "Eine im Forum hat es genau so beschrieben.",
   "start": 13.28487245990923,
   "dur": 2.471001848714069,
   "speakStart": 13.28487245990923
  },
  {
   "id": "s5",
   "text": "Dann kam das Tape. Die Lippenmaske sitzt direkt in der Mitte, mit Kollagen und Hyaluronsäure.",
   "start": 15.7558743086233,
   "dur": 5.571866913767019,
   "speakStart": 15.7558743086233
  },
  {
   "id": "s6",
   "text": "Und weil das Tape drüberklebt, bleibt die Pflege die ganze Nacht da, wo sie hin soll.",
   "start": 21.32774122239032,
   "dur": 4.942003697428142,
   "speakStart": 21.32774122239032
  },
  {
   "id": "s7",
   "text": "Morgens fühlen sich meine Lippen weich und irgendwie voller an. Und mein Kissen ist einfach nur ein Kissen.",
   "start": 26.26974491981846,
   "dur": 6.306377080181537,
   "speakStart": 26.26974491981846
  }
 ],
