{
 "scenes": [
  {
   "id": "s1",
   "text": "Ich hatte einen Termin für meine Lippen. Abgesagt. Zweimal.",
   "start": 0,
   "dur": 5.047094801223242,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Ich bin 57 und hab zu viel Angst, dass es schiefgeht und jeder es sieht.",
   "start": 5.047094801223242,
   "dur": 4.691896024464832,
   "speakStart": 5.047094801223242
  },
  {
   "id": "s3",
   "text": "In einem Forum stand genau, was ich gedacht hab.",
   "start": 9.738990825688074,
   "dur": 3.367125382262998,
   "speakStart": 9.738990825688074
  },
  {
   "id": "s4",
   "text": "Also tu ich jetzt abends selbst was für meine Lippen.",
   "start": 13.106116207951072,
   "dur": 3.4223241590214073,
   "speakStart": 13.106116207951072
  },
  {
   "id": "s5",
   "text": "Ein Tape aus medizinischer Baumwolle, in der Mitte Pflege mit Kollagen, Hyaluronsäure und Vitamin E.",
   "start": 16.52844036697248,
   "dur": 6.458256880733945,
   "speakStart": 16.52844036697248
  },
  {
   "id": "s6",
   "text": "Abends drauf, morgens langsam ab. Keiner merkt was. Nur ich: Meine Lippen fühlen sich weich an.",
   "start": 22.986697247706424,
   "dur": 7.175840978593271,
   "speakStart": 22.986697247706424
  },
  {
   "id": "s7",
   "text": "Ob ich irgendwann doch hingehe? Weiß ich nicht. Aber abends hab ich jetzt mein Ritual.",
   "start": 30.162538226299695,
   "dur": 6.4874617737003035,
   "speakStart": 30.162538226299695
  }
 ],
