{
 "scenes": [
  {
   "id": "s1",
   "text": "Mein Nachttisch mit 52. Lesebrille. Ein Krimi, den ich nie fertig kriege.",
   "start": 0,
   "dur": 5.6507681826484015,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Eine Handcreme, die nach Mandel riecht. Und eine kleine rosa Schachtel.",
   "start": 5.6507681826484015,
   "dur": 4.784821547945207,
   "speakStart": 5.6507681826484015
  },
  {
   "id": "s3",
   "text": "Da sind dreißig Tapes drin. Eins für jede Nacht.",
   "start": 10.435589730593609,
   "dur": 3.395679808219178,
   "speakStart": 10.435589730593609
  },
  {
   "id": "s4",
   "text": "Bevor ich das Buch weglege, kommt eins über die Lippen. In der Mitte Pflege mit Kollagen und Vitamin E.",
   "start": 13.831269538812787,
   "dur": 6.431211757990866,
   "speakStart": 13.831269538812787
  },
  {
   "id": "s5",
   "text": "Früher lag da ein Lippenbalsam, und die Pflege war morgens im Kissen. Jetzt bleibt sie, wo sie hin soll.",
   "start": 20.262481296803653,
   "dur": 6.688460228310504,
   "speakStart": 20.262481296803653
  },
  {
   "id": "s6",
   "text": "Morgens zieh ich es langsam ab, und meine Lippen fühlen sich weich an. Das ist mein Lieblingsteil auf dem Nachttisch.",
   "start": 26.950941525114157,
   "dur": 7.401507474885843,
   "speakStart": 26.950941525114157
  }
 ],
