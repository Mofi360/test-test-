{
 "scenes": [
  {
   "id": "s1",
   "text": "Du trägst vielleicht das falsche Rot. Schau auf dein Handgelenk.",
   "start": 0,
   "dur": 4.469023569023569,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Am besten am Fenster, bei Tageslicht. Siehst du die Adern? Mach den Test jetzt, ich warte.",
   "start": 4.469023569023569,
   "dur": 6.3552188552188555,
   "speakStart": 4.469023569023569
  },
  {
   "id": "s3",
   "text": "Wirken sie bläulich oder violett? Dann hast du eher einen kühlen Unterton.",
   "start": 10.824242424242424,
   "dur": 4.677441077441079,
   "speakStart": 10.824242424242424
  },
  {
   "id": "s4",
   "text": "Dazu passt Rot mit Blaustich. Himbeerrot zum Beispiel, oder Karminrot.",
   "start": 15.501683501683504,
   "dur": 4.677441077441076,
   "speakStart": 15.501683501683504
  },
  {
   "id": "s5",
   "text": "Wirken sie eher grünlich? Dann bist du eher der warme Typ.",
   "start": 20.17912457912458,
   "dur": 3.8639730639730594,
   "speakStart": 20.17912457912458
  },
  {
   "id": "s6",
   "text": "Dein Rot hat dann einen Orangestich. Tomatenrot oder Korallenrot.",
   "start": 24.04309764309764,
   "dur": 4.21986531986532,
   "speakStart": 24.04309764309764
  },
  {
   "id": "s7",
   "text": "Du erkennst es nicht? Dann probier einfach beide Richtungen aus.",
   "start": 28.26296296296296,
   "dur": 4.169023569023565,
   "speakStart": 28.26296296296296
  },
  {
   "id": "s8",
   "text": "Ehrlich gesagt: Das ist nur eine Faustregel aus der Drogerie. Am Ende entscheidet dein Spiegel.",
   "start": 32.431986531986524,
   "dur": 5.948484848484846,
   "speakStart": 32.431986531986524
  },
  {
   "id": "s9",
   "text": "Schick das deiner Freundin, die seit Jahren sagt: Rot steht mir nicht. Und jetzt du: blau, grün oder beides?",
   "start": 38.38047138047137,
   "dur": 7.469528619528624,
   "speakStart": 38.38047138047137
  }
 ],
