{
 "scenes": [
  {
   "id": "s1",
   "text": "Ich bin 51 und hatte sechs Lippenbalsame in der Handtasche. Sechs.",
   "start": 0,
   "dur": 4.871681415929203,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Morgens drauf, nach dem Kaffee drauf, nach dem Mittag drauf. Und abends waren meine Lippen trotzdem trocken.",
   "start": 4.871681415929203,
   "dur": 7.292920353982302,
   "speakStart": 4.871681415929203
  },
  {
   "id": "s3",
   "text": "Einer Frau in einem Forum ging es genauso.",
   "start": 12.164601769911505,
   "dur": 2.775663716814158,
   "speakStart": 12.164601769911505
  },
  {
   "id": "s4",
   "text": "Irgendwann fiel mir auf: Tagsüber creme ich ständig nach. Nachts liegt gar nichts drauf.",
   "start": 14.940265486725663,
   "dur": 5.9867256637168165,
   "speakStart": 14.940265486725663
  },
  {
   "id": "s5",
   "text": "Jetzt kommt abends ein Tape über die geschlossenen Lippen. In der Mitte Pflege mit Kollagen, Hyaluronsäure, Glycerin und Vitamin E.",
   "start": 20.92699115044248,
   "dur": 8.544690265486725,
   "speakStart": 20.92699115044248
  },
  {
   "id": "s6",
   "text": "Und die bleibt die ganze Nacht da, wo sie hin soll.",
   "start": 29.471681415929204,
   "dur": 3.483185840707961,
   "speakStart": 29.471681415929204
  },
  {
   "id": "s7",
   "text": "In meiner Handtasche ist jetzt noch einer. Einer reicht mir.",
   "start": 32.954867256637165,
   "dur": 4.495132743362831,
   "speakStart": 32.954867256637165
  }
 ],
