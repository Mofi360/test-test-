{
 "scenes": [
  {
   "id": "s1",
   "text": "Sonntagabend, kurz nach neun. Die Woche ist vorbei, die Küche ist sauber, und jetzt bin ich dran.",
   "start": 0,
   "dur": 6.946887200710479,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Tee auf den Nachttisch. Gesicht waschen. Creme.",
   "start": 6.946887200710479,
   "dur": 3.8729893925399663,
   "speakStart": 6.946887200710479
  },
  {
   "id": "s3",
   "text": "Und zum Schluss das Tape. Haut um den Mund trocken, Lippen zu, drüberlegen, kurz andrücken.",
   "start": 10.819876593250445,
   "dur": 6.332861033747779,
   "speakStart": 10.819876593250445
  },
  {
   "id": "s4",
   "text": "In der Mitte ist eine Lippenmaske mit Kollagen und Hyaluronsäure. Die pflegt meine Lippen, während ich schlafe.",
   "start": 17.152737626998224,
   "dur": 6.960913367673179,
   "speakStart": 17.152737626998224
  },
  {
   "id": "s5",
   "text": "Mit 53 hab ich aufgehört, mich für solche Momente zu entschuldigen.",
   "start": 24.113650994671403,
   "dur": 4.187015559502665,
   "speakStart": 24.113650994671403
  },
  {
   "id": "s6",
   "text": "Montag kann kommen.",
   "start": 28.300666554174068,
   "dur": 1.7154554458259312,
   "speakStart": 28.300666554174068
  }
 ],
