{
 "scenes": [
  {
   "id": "s1",
   "text": "Dunkel, hell oder glänzend: Was lässt Lippen voller wirken?",
   "start": 0,
   "dur": 3.721759259259259,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Rate kurz mit. Option eins: dunkle Töne. Dunkles Braun, Weinrot, Violett.",
   "start": 3.721759259259259,
   "dur": 5.042592592592594,
   "speakStart": 3.721759259259259
  },
  {
   "id": "s3",
   "text": "Die lassen Lippen optisch eher schmaler wirken.",
   "start": 8.764351851851853,
   "dur": 2.5212962962962955,
   "speakStart": 8.764351851851853
  },
  {
   "id": "s4",
   "text": "Option zwei: helle Töne. Rosa, Nude, Pfirsich. Die lassen Lippen optisch größer wirken.",
   "start": 11.285648148148148,
   "dur": 5.672916666666666,
   "speakStart": 11.285648148148148
  },
  {
   "id": "s5",
   "text": "Option drei: Glanz. Glänzende Lippen reflektieren Licht. Dadurch treten sie optisch hervor.",
   "start": 16.958564814814814,
   "dur": 5.4928240740740755,
   "speakStart": 16.958564814814814
  },
  {
   "id": "s6",
   "text": "Also: Hell und Glanz liegen vorn. Aber das sind nur Schmink-Faustregeln.",
   "start": 22.45138888888889,
   "dur": 4.232175925925922,
   "speakStart": 22.45138888888889
  },
  {
   "id": "s7",
   "text": "Dunkel ist deshalb nicht verboten. Wer Weinrot liebt, trägt Weinrot. Punkt.",
   "start": 26.68356481481481,
   "dur": 4.772453703703707,
   "speakStart": 26.68356481481481
  },
  {
   "id": "s8",
   "text": "Schick das deiner Freundin, die nur Dunkel trägt. Und sich dann über schmale Lippen beschwert. Sag mir: Team dunkel, hell oder Glanz?",
   "start": 31.45601851851852,
   "dur": 8.393981481481475,
   "speakStart": 31.45601851851852
  }
 ],
