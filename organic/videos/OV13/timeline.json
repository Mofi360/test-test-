{
 "scenes": [
  {
   "id": "s1",
   "text": "Mein Freund kommt ins Schlafzimmer, und ich lieg da mit Tape auf dem Mund.",
   "start": 0,
   "dur": 4.277142878424658,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Er: Okay. Muss ich mir Sorgen machen?",
   "start": 4.277142878424658,
   "dur": 2.697142871575342,
   "speakStart": 4.277142878424658
  },
  {
   "id": "s3",
   "text": "Ich, durchs Tape: Mhm mhm.",
   "start": 6.97428575,
   "dur": 1.9657142962328784,
   "speakStart": 6.97428575
  },
  {
   "id": "s4",
   "text": "Für alle, die genauso gucken: Das ist Lippenpflege. In der Mitte Kollagen, Hyaluronsäure und Vitamin E.",
   "start": 8.940000046232878,
   "dur": 6.080000032534246,
   "speakStart": 8.940000046232878
  },
  {
   "id": "s5",
   "text": "Die Pflege bleibt die ganze Nacht da, wo sie hin soll. Nicht mehr im Kissen.",
   "start": 15.020000078767124,
   "dur": 4.480000023972602,
   "speakStart": 15.020000078767124
  },
  {
   "id": "s6",
   "text": "Und ja, in der Mitte ist ein kleines Loch. Hat er auch gefragt.",
   "start": 19.500000102739726,
   "dur": 3.8857143065068485,
   "speakStart": 19.500000102739726
  },
  {
   "id": "s7",
   "text": "Inzwischen fragt er abends nur noch:",
   "start": 23.385714409246575,
   "dur": 1.8285714383561675,
   "speakStart": 23.385714409246575
  },
  {
   "id": "s8",
   "text": "Hast du dein Tape schon drauf?",
   "start": 25.214285847602742,
   "dur": 2.032857152397259,
   "speakStart": 25.214285847602742
  }
 ],
