{
 "scenes": [
  {
   "id": "s1",
   "text": "Du heiratest bald und willst rote Lippen auf jedem Foto?",
   "start": 0,
   "dur": 3.609682804674457,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Probe-Make-up steht. Fotografin gebucht. Sekt steht kalt.",
   "start": 3.609682804674457,
   "dur": 4.2771285475792995,
   "speakStart": 3.609682804674457
  },
  {
   "id": "s3",
   "text": "Alle planen Kleid, Frisur und Blumen. An die Lippen denkt keiner.",
   "start": 7.886811352253757,
   "dur": 4.429883138564273,
   "speakStart": 7.886811352253757
  },
  {
   "id": "s4",
   "text": "Dabei sind gepflegte, weiche Lippen die Basis für dein Rot.",
   "start": 12.31669449081803,
   "dur": 3.666110183639402,
   "speakStart": 12.31669449081803
  },
  {
   "id": "s5",
   "text": "Darum in den Wochen davor, abends als letzter Schritt: Diva Tape. Ein Kollagen-Tape, das deine Lippen über Nacht pflegt.",
   "start": 15.982804674457432,
   "dur": 7.637729549248748,
   "speakStart": 15.982804674457432
  },
  {
   "id": "s6",
   "text": "Erst pflegen, dann Ja sagen.",
   "start": 23.62053422370618,
   "dur": 2.0876460767946554,
   "speakStart": 23.62053422370618
  },
  {
   "id": "s7",
   "text": "Schick das deiner Freundin, die bald heiratet. Rot, Rosé oder Nude zum Ja?",
   "start": 25.708180300500835,
   "dur": 5.341819699499165,
   "speakStart": 25.708180300500835
  }
 ],
