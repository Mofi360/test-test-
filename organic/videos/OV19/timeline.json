{
 "scenes": [
  {
   "id": "s1",
   "text": "Kollagen-Tape. Klingt nach Hype. Also hab ich nachgeguckt, was drin ist.",
   "start": 0,
   "dur": 5.405636150943397,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Außen: medizinische Baumwolle und ein hypoallergener, atmungsaktiver Kleber.",
   "start": 5.405636150943397,
   "dur": 4.609943320754717,
   "speakStart": 5.405636150943397
  },
  {
   "id": "s3",
   "text": "In der Mitte die Pflege. Unter anderem Wasser, Glycerin, Hyaluronsäure, Vitamin E, das steht in der Liste als Tocopherol, und Kollagen.",
   "start": 10.015579471698114,
   "dur": 8.575485962264153,
   "speakStart": 10.015579471698114
  },
  {
   "id": "s4",
   "text": "Kollagen kennst du aus jeder Beauty-Werbung. Hier ist es Teil der Pflege, die über Nacht auf deinen Lippen liegt. Mehr verspricht es nicht.",
   "start": 18.591065433962267,
   "dur": 8.426778113207543,
   "speakStart": 18.591065433962267
  },
  {
   "id": "s5",
   "text": "Dazu ein kleines Sicherheitsloch in der Mitte.",
   "start": 27.01784354716981,
   "dur": 2.7263105660377356,
   "speakStart": 27.01784354716981
  },
  {
   "id": "s6",
   "text": "Und in einer Packung von Diva Tape sind dreißig Stück. Also dreißig Nächte.",
   "start": 29.744154113207546,
   "dur": 4.609943320754713,
   "speakStart": 29.744154113207546
  },
  {
   "id": "s7",
   "text": "Speicher dir das, falls dich jemand fragt.",
   "start": 34.35409743396226,
   "dur": 2.976310566037739,
   "speakStart": 34.35409743396226
  }
 ],
