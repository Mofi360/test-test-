{
 "scenes": [
  {
   "id": "s1",
   "text": "Beim Aufräumen fiel mir ein Foto von 1998 in die Hand. Ich auf einer Gartenparty, lachend.",
   "start": 0,
   "dur": 6.0737976252072965,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Und ich hab nur auf eins geschaut: meinen Mund.",
   "start": 6.0737976252072965,
   "dur": 3.0931058706467667,
   "speakStart": 6.0737976252072965
  },
  {
   "id": "s3",
   "text": "Machen lassen wollte ich nie. Zu viel Angst, dass es gemacht aussieht.",
   "start": 9.166903495854063,
   "dur": 4.742762334991708,
   "speakStart": 9.166903495854063
  },
  {
   "id": "s4",
   "text": "Ich wollte selbst was tun. Abends, in Ruhe.",
   "start": 13.909665830845771,
   "dur": 3.3508646932006627,
   "speakStart": 13.909665830845771
  },
  {
   "id": "s5",
   "text": "Jetzt kommt abends ein Tape auf die Lippen. Mit Pflege in der Mitte, die über Nacht Feuchtigkeit spendet.",
   "start": 17.260530524046434,
   "dur": 6.547074092868989,
   "speakStart": 17.260530524046434
  },
  {
   "id": "s6",
   "text": "Morgens fühlen sich meine Lippen weich an. Und ich schau wieder gern in den Spiegel.",
   "start": 23.807604616915423,
   "dur": 5.258279980099502,
   "speakStart": 23.807604616915423
  },
  {
   "id": "s7",
   "text": "Das Foto hängt jetzt am Kühlschrank.",
   "start": 29.065884597014925,
   "dur": 2.569829402985075,
   "speakStart": 29.065884597014925
  }
 ],
