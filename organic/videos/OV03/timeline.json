{
 "scenes": [
  {
   "id": "s1",
   "text": "Beim Aufräumen fiel mir ein Foto von 1998 in die Hand. Ich auf einer Gartenparty, lachend.",
   "start": 0,
   "dur": 6.6336650082918736,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Und ich hab nur auf eins geschaut: meinen Mund.",
   "start": 6.6336650082918736,
   "dur": 3.3930348258706475,
   "speakStart": 6.6336650082918736
  },
  {
   "id": "s3",
   "text": "Machen lassen wollte ich nie. Zu viel Angst, dass es gemacht aussieht.",
   "start": 10.026699834162521,
   "dur": 5.202653399668327,
   "speakStart": 10.026699834162521
  },
  {
   "id": "s4",
   "text": "Ich wollte selbst was tun. Abends, in Ruhe.",
   "start": 15.229353233830848,
   "dur": 3.675787728026533,
   "speakStart": 15.229353233830848
  },
  {
   "id": "s5",
   "text": "Jetzt kommt abends ein Tape auf die Lippen. Mit Pflege in der Mitte, die über Nacht Feuchtigkeit spendet.",
   "start": 18.90514096185738,
   "dur": 7.181923714759538,
   "speakStart": 18.90514096185738
  },
  {
   "id": "s6",
   "text": "Morgens fühlen sich meine Lippen weich an. Und ich schau wieder gern in den Spiegel.",
   "start": 26.08706467661692,
   "dur": 5.7681592039800975,
   "speakStart": 26.08706467661692
  },
  {
   "id": "s7",
   "text": "Das Foto hängt jetzt am Kühlschrank.",
   "start": 31.855223880597016,
   "dur": 2.7947761194029823,
   "speakStart": 31.855223880597016
  }
 ],
