{
 "scenes": [
  {
   "id": "s1",
   "text": "Das Erste, was ich morgens mache, noch bevor der Kaffee läuft.",
   "start": 0,
   "dur": 4.330551690431519,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Ich zieh das Tape ab. Langsam und ganz in Ruhe.",
   "start": 4.330551690431519,
   "dur": 3.3162767073170745,
   "speakStart": 4.330551690431519
  },
  {
   "id": "s3",
   "text": "Dann der Blick in den Badspiegel. Und dieses Gefühl: weich.",
   "start": 7.646828397748593,
   "dur": 4.132590973733584,
   "speakStart": 7.646828397748593
  },
  {
   "id": "s4",
   "text": "Die ganze Nacht lag da eine Pflege mit Kollagen, Hyaluronsäure und Vitamin E drauf.",
   "start": 11.779419371482177,
   "dur": 4.897885598499062,
   "speakStart": 11.779419371482177
  },
  {
   "id": "s5",
   "text": "Ich bin 49. Ich hab lange gedacht, für meine Lippen lohnt sich nichts mehr.",
   "start": 16.67730496998124,
   "dur": 4.9489052401500935,
   "speakStart": 16.67730496998124
  },
  {
   "id": "s6",
   "text": "Aber dieses kleine Ritual, das gönn ich mir. Jeden Morgen. Und dann erst den Kaffee.",
   "start": 21.626210210131333,
   "dur": 6.117258789868668,
   "speakStart": 21.626210210131333
  }
 ],
