{
 "scenes": [
  {
   "id": "s1",
   "text": "Das Erste, was ich morgens mache, noch bevor der Kaffee läuft.",
   "start": 0,
   "dur": 4.761350844277673,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Ich zieh das Tape ab. Langsam und ganz in Ruhe.",
   "start": 4.761350844277673,
   "dur": 3.670731707317075,
   "speakStart": 4.761350844277673
  },
  {
   "id": "s3",
   "text": "Dann der Blick in den Badspiegel. Und dieses Gefühl: weich.",
   "start": 8.432082551594748,
   "dur": 4.574296435272046,
   "speakStart": 8.432082551594748
  },
  {
   "id": "s4",
   "text": "Die ganze Nacht lag da eine Pflege mit Kollagen, Hyaluronsäure und Vitamin E drauf.",
   "start": 13.006378986866794,
   "dur": 5.421388367729831,
   "speakStart": 13.006378986866794
  },
  {
   "id": "s5",
   "text": "Ich bin 49. Ich hab lange gedacht, für meine Lippen lohnt sich nichts mehr.",
   "start": 18.427767354596625,
   "dur": 5.477861163227018,
   "speakStart": 18.427767354596625
  },
  {
   "id": "s6",
   "text": "Aber dieses kleine Ritual, das gönn ich mir. Jeden Morgen. Und dann erst den Kaffee.",
   "start": 23.905628517823644,
   "dur": 6.7443714821763585,
   "speakStart": 23.905628517823644
  }
 ],
