{
 "scenes": [
  {
   "id": "s1",
   "text": "Drei Winter-Fehler, die ich jahrelang gemacht hab. Nummer drei hat mich überrascht.",
   "start": 0,
   "dur": 5.427906976744187,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Eins: Heizung voll aufgedreht, und die Luft im Schlafzimmer ist staubtrocken.",
   "start": 5.427906976744187,
   "dur": 4.590697674418606,
   "speakStart": 5.427906976744187
  },
  {
   "id": "s3",
   "text": "Zwei: Lippen ablecken, wenn sie spannen. Fühlt sich kurz gut an, macht es aber nicht besser.",
   "start": 10.018604651162793,
   "dur": 5.9581395348837205,
   "speakStart": 10.018604651162793
  },
  {
   "id": "s4",
   "text": "Drei: Den ganzen Tag nachcremen und nachts gar nichts. Dabei liegt nachts stundenlang nichts drauf.",
   "start": 15.976744186046513,
   "dur": 5.909302325581393,
   "speakStart": 15.976744186046513
  },
  {
   "id": "s5",
   "text": "Meine Kosmetikerin hat mir erklärt: Lippen haben keine eigenen Talgdrüsen. Deshalb trocknen sie schneller aus.",
   "start": 21.886046511627907,
   "dur": 6.446511627906979,
   "speakStart": 21.886046511627907
  },
  {
   "id": "s6",
   "text": "Seitdem kommt abends ein Tape mit Pflege-Mitte drauf. Das spendet über Nacht Feuchtigkeit.",
   "start": 28.332558139534886,
   "dur": 5.2744186046511565,
   "speakStart": 28.332558139534886
  },
  {
   "id": "s7",
   "text": "Speicher dir das für die Heizungssaison.",
   "start": 33.60697674418604,
   "dur": 2.643023255813958,
   "speakStart": 33.60697674418604
  }
 ],
