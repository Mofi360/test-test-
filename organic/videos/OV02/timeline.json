{
 "scenes": [
  {
   "id": "s1",
   "text": "Hochzeit meiner Nichte. Ich im Flur, in der Hand mein alter roter Lippenstift.",
   "start": 0,
   "dur": 5.50393811533052,
   "speakStart": 0.3
  },
  {
   "id": "s2",
   "text": "Früher mein Lieblingsstück. Aufgetragen, kurz geguckt, mit dem Taschentuch wieder runter.",
   "start": 5.50393811533052,
   "dur": 5.984528832630099,
   "speakStart": 5.50393811533052
  },
  {
   "id": "s3",
   "text": "Später hab ich in einem Forum gelesen, dass es anderen genauso geht.",
   "start": 11.48846694796062,
   "dur": 4.215189873417723,
   "speakStart": 11.48846694796062
  },
  {
   "id": "s4",
   "text": "Ich hab dann keinen neuen Lippenstift gekauft. Ich hab angefangen, meine Lippen nachts zu pflegen.",
   "start": 15.703656821378342,
   "dur": 6.244725738396625,
   "speakStart": 15.703656821378342
  },
  {
   "id": "s5",
   "text": "Ein Tape, das abends über die geschlossenen Lippen kommt. In der Mitte Pflege mit Kollagen und Hyaluronsäure.",
   "start": 21.948382559774966,
   "dur": 6.817158931082982,
   "speakStart": 21.948382559774966
  },
  {
   "id": "s6",
   "text": "Morgens fühlten sie sich weich an. Irgendwie voller.",
   "start": 28.76554149085795,
   "dur": 3.6427566807313596,
   "speakStart": 28.76554149085795
  },
  {
   "id": "s7",
   "text": "Beim Geburtstag meiner Schwester hab ich ihn drangelassen. Den ganzen Abend.",
   "start": 32.40829817158931,
   "dur": 5.141701828410689,
   "speakStart": 32.40829817158931
  }
 ],
